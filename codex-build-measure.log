    "'$samples += [pscustomobject]@{ FrameMs = $r.frameMs; Frame = $r.frame; DrawCalls = $r.lastNonZeroDrawCalls; IsWorld3D = $r.isWorld3D; BuildingRenderBudget = $r.buildingRenderBudget; BuildingsVisible = $r.buildingsVisible; BuildingsInFrustum = $r.buildingsInFrustum }
  } catch { $samples += [pscustomobject]@{ FrameMs = $null; Frame = -1; Error = $_.Exception.Message } }
  Start-Sleep -Milliseconds 100
}

# 9) Save telemetry CSV and compute metrics
$telemetryCsv = Join-Path $root '"'telemetry-after.csv'
"'$samples | Export-Csv -NoTypeInformation -Path $telemetryCsv
function Get-Median([array]$arr) {
  if ($arr.Count -eq 0) { return $null }
  $sorted = @($arr | Sort-Object)
  $n = $sorted.Count
  if (($n % 2) -eq 1) { return [double]$sorted[[int][Math]::Floor($n / 2)] }
  return (([double]$sorted[[int]($n / 2 - 1)] + [double]$sorted[[int]($n / 2)]) / 2.0)
}
$valid = $samples | Where-Object { $_.FrameMs -ne $null }
$frameMsVals = @()
foreach ($s in $valid) { $frameMsVals += [double]$s.FrameMs }
$result.telemetry.valid_count = $frameMsVals.Count
$result.telemetry.null_count = $samples.Count - $frameMsVals.Count

if ($frameMsVals.Count -gt 0) {
  $sorted = $frameMsVals | Sort-Object
  $result.telemetry.median_ms = [Math]::Round((Get-Median $sorted), 3)
  $idx = [int][Math]::Ceiling($sorted.Count * 0.95) - 1
  if ($idx -lt 0) { $idx = 0 }
  if ($idx -ge $sorted.Count) { $idx = $sorted.Count - 1 }
  $result.telemetry.p95_ms = [Math]::Round([double]$sorted[$idx], 3)
  $result.telemetry.min_ms = [Math]::Round([double]$sorted[0], 3)
  $result.telemetry.max_ms = [Math]::Round([double]$sorted[-1], 3)

  $stats = $sorted | Measure-Object -Average -StandardDeviation
  $result.telemetry.mean_ms = [Math]::Round([double]$stats.Average, 3)
  $result.telemetry.stdev_ms = [Math]::Round([double]$stats.StandardDeviation, 3)
}

$infr = @()
$vis = @()
foreach ($s in $samples) {
  if ($s.BuildingsInFrustum -ne $null) { $infr += [int]$s.BuildingsInFrustum }
  if ($s.BuildingsVisible -ne $null) { $vis += [int]$s.BuildingsVisible }
}
$result.buildings_in_frustum_median = if ($infr.Count -gt 0) { [int](Get-Median $infr) } else { 0 }
$result.buildings_visible_median = if ($vis.Count -gt 0) { [int](Get-Median $vis) } else { 0 }

# 10/11 log counts in last 60s
$logPath = Join-Path $env:USERPROFILE '"'AppData\\LocalLow\\mkarpenko\\WorldBox\\Player.log'
if (Test-Path "'$logPath) {
  $allLines = Get-Content -Path $logPath
  $cutoff = (Get-Date).AddSeconds(-60)
  $startLine = 1

  for ($i = 0; $i -lt $allLines.Count; $i++) {
    $line = $allLines[$i]
    $ts = $null
    if ($line -match '"'"'^(?<ts>'"\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})') {
      try { "'$ts = [DateTime]::ParseExact($matches.ts, '"'yyyy-MM-dd HH:mm:ss', "'$null) } catch {}
    } elseif ($line -match '"'"'^(?<ts>'"\\d{2}\\/\\d{2}\\/\\d{2} \\d{2}:\\d{2}:\\d{2})') {
      try { "'$ts = [DateTime]::ParseExact($matches.ts, '"'yy/MM/dd HH:mm:ss', "'$null) } catch {}
    }
    if ($ts -ne $null -and $ts -ge $cutoff) { $startLine = $i + 1; break }
  }

  $slowCount = Select-String -Path $logPath -Pattern '"'SLOW' | Where-Object { "'$_.LineNumber -ge $startLine } | Measure-Object | Select-Object -ExpandProperty Count
  $renderCount = Select-String -Path $logPath -Pattern '"'render3DStuff.*SLOW|render3DStuff.*[0-9]+ms' | Where-Object { "'$_.LineNumber -ge $startLine } | Measure-Object | Select-Object -ExpandProperty Count
  $result.slow_log_count_60s = [int]$slowCount
  $result.render3DStuff_slow_count_60s = [int]$renderCount
}

if (-not $result.bridge_up -and $result.exit_code -eq 0) {
  $result.exit_code = 2
  $result.blocker = '"'bridge_not_up'
}

