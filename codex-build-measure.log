"'$argLine = [string]::Join('"' ', ("'$la | ForEach-Object { '"'\"' + "'$_ + '"'\"' }))
"'$proc = Start-Process -FilePath pwsh -ArgumentList $argLine -WorkingDirectory $root -NoNewWindow -RedirectStandardOutput $launchLog -RedirectStandardError $launchErr -PassThru
$bridgeDone = $proc.WaitForExit(8 * 60 * 1000)
