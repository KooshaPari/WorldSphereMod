function Get-Median([array]$arr) {
  if ($arr.Count -eq 0) { return $null }
  $sorted = $arr | Sort-Object
  $n = $sorted.Count
  if (($n % 2) -eq 1) { return [double]$sorted[[int][math]::Floor($n/2)] }
  $low = [int]($n/2 - 1)
  $high = [int]($n/2)
  return ([double]$sorted[$low] + [double]$sorted[$high]) / 2.0
}

$valid = $samples | Where-Object { $_.FrameMs -ne $null }
$frameVals = @()
foreach ($sample in $valid) { [void]($frameVals += [double]$sample.FrameMs) }
$frameCount = $frameVals.Count
$result.telemetry.valid_count = $frameCount
$result.telemetry.null_count = $samples.Count - $frameCount

if ($frameCount -gt 0) {
  $sorted = $frameVals | Sort-Object
  $result.telemetry.median_ms = [math]::Round((Get-Median $sorted), 3)
  $idx = [math]::Max(0, [int]([math]::Ceiling($frameCount * 0.95) - 1))
  if ($idx -ge $sorted.Count) { $idx = $sorted.Count - 1 }
  $result.telemetry.p95_ms = [math]::Round([double]$sorted[$idx], 3)
  $result.telemetry.min_ms = [math]::Round([double]$sorted[0], 3)
  $result.telemetry.max_ms = [math]::Round([double]$sorted[-1], 3)

  $m = $frameVals | Measure-Object -Average -StandardDeviation
  if ($m.Count -gt 0) { $result.telemetry.mean_ms = [math]::Round([double]$m.Average, 3) }
  if ($m.StandardDeviation -ne $null) { $result.telemetry.stdev_ms = [math]::Round([double]$m.StandardDeviation, 3) }
}

$frustumVals = @(); $visibleVals = @()
foreach ($sample in $samples) {
  if ($sample.BuildingsInFrustum -ne $null) { [void]($frustumVals += [int]$sample.BuildingsInFrustum) }
  if ($sample.BuildingsVisible -ne $null) { [void]($visibleVals += [int]$sample.BuildingsVisible) }
}
$result.buildings_in_frustum_median = if ($frustumVals.Count -gt 0) { [int](Get-Median $frustumVals) } else { 0 }
$result.buildings_visible_median = if ($visibleVals.Count -gt 0) { [int](Get-Median $visibleVals) } else { 0 }

# 10-11) Count SLOW in Player.log and render3DStuff SLOW lines in last 60s
