    buildings_in_frustum_median = 0
    buildings_visible_median = 0
    blocker = '"'DONE'
}

# 2) Ensure worldbox not running
try {
    Get-Process -Name worldbox -ErrorAction SilentlyContinue | ForEach-Object { "'$_.Id } | ForEach-Object { taskkill /F /IM worldbox.exe | Out-Null }
} catch {}

# 3) Ensure stale DLL removed
$stalePath = '"'C:/Program Files (x86)/Steam/steamapps/common/Worldbox/worldbox_Data/StreamingAssets/Mods/NML/CompiledMods/WORLDSPHERE3D_FORK.dll'
if (Test-Path "'$stalePath) {
