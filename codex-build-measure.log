"'$startLine = 1
if (Test-Path $logPath) {
  $lines = Get-Content -Path $logPath
  $cutoff = (Get-Date).AddSeconds(-60)
  for ($i = 0; $i -lt $lines.Count; $i++) {
    $lineText = $lines[$i]
    $ts = $null
    if ($lineText -match '"'"'^(?<ts>'"\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})') {
      try { "'$ts = [DateTime]::ParseExact($matches.ts, '"'yyyy-MM-dd HH:mm:ss', "'$null) } catch {}
    } elseif ($lineText -match '"'"'^(?<ts>'"\\d{2}\\/\\d{2}\\/\\d{2} \\d{2}:\\d{2}:\\d{2})') {
