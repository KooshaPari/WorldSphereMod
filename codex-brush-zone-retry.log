        static int ResolveRenderLayer(int layer, Camera cam)
        {
            if (layer != 0) return layer;

            if (cam == null) return 0;

            int mask = cam.cullingMask;
            if (mask == 0) return 0;

            int resolved = 0;
            while (((mask >> resolved) & 1) == 0 && resolved < 31)
            {
                resolved++;
            }

            return resolved;
        }

