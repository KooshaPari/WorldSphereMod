+                        int c1 = c0 + 1;
+                        int c2 = c0 + cornerCols;
+                        int c3 = c2 + 1;
+
+                        int cr0 = r;
+                        int cr1 = r + 1;
+                        int cc0 = c;
+                        int cc1 = c + 1;
+
+                        int n0 = c0;
+                        int n1 = c1;
