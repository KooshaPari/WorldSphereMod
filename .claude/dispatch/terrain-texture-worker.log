+                {
+                    int tileX = rowIndices[r];
+                    for (int c = 0; c < cols; c++)
+                    {
+                        int dominantTex = DominantTexture(_cornerTexture[bl], _cornerTexture[br], _cornerTexture[tl], _cornerTexture[tr]);
+
+                        int bl = r * cornerCols + c;
+                        int br = bl + 1;
+                        int tl = bl + cornerCols;
+                        int tr = tl + 1;
+
+                        int b0 = (r * cols + c) * 4;
+                        int b1 = b0 + 1;
+                        int b2 = b0 + 2;
+                        int b3 = b0 + 3;
+
+                        float worldX0 = ResolveCornerWorldX(r, rowIndices, rowCount);
+                        float worldX1 = ResolveCornerWorldX(r + 1, rowIndices, rowCount);
+                        float worldY0 = c - 0.5f;
