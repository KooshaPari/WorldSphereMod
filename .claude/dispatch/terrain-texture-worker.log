+                    $"reason={_lastRebuildReason} " +
+                    $"(bake={bakeMs}ms tri={triMs - bakeMs}ms norm={normMs - triMs}ms " +
+                    $"upload={totalMs - normMs}ms verts={vertCount} tris={triCount / 3}) " +
+                    "[steady-* reason climbing while idle => sim render_z flicker; " +
