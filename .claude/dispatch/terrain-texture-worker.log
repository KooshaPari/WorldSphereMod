diff --git a/tests/WorldSphereMod.Tests.E2E/HeightFieldTerrainTextureArrayInvariantsTests.cs b/tests/WorldSphereMod.Tests.E2E/HeightFieldTerrainTextureArrayInvariantsTests.cs
new file mode 100644
