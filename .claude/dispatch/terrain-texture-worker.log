+                        int br = bl + 1;
+                        int tl = bl + cornerCols;
+                        int tr = tl + 1;
+
+                        _triangles[ti++] = bl;
+                        _triangles[ti++] = tl;
+                        _triangles[ti++] = br;
+
+                        _triangles[ti++] = br;
+                        _triangles[ti++] = tl;
+                        _triangles[ti++] = tr;
+                    }
