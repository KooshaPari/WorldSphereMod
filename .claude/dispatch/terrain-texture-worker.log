                // 0..1 UVs and a tile texture slice.
                for (int r = 0; r < rowCount; r++)
                {
                    int tileX = rowIndices[r];
                    for (int c = 0; c < cols; c++)
                    {
                        int dominantTex = _sampleTexture(tileX, c);
                        if (dominantTex < 0) dominantTex = 0;

                        int bl = r * cornerCols + c;
                        int br = bl + 1;
                        int tl = bl + cornerCols;
                        int tr = tl + 1;

