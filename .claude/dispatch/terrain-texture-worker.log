+        static int ResolveCornerRowIndex(int localRow, int rowCount, int[] rowIndices)
+        {
+            if (localRow < 0) return rowIndices[0];
+            if (localRow >= rowCount) return rowIndices[rowCount - 1];
+            return rowIndices[localRow];
+        }
+
+        static float ResolveCornerWorldX(int rowOffset, int[] rowIndices, int rowCount)
+        {
+            if (rowOffset < rowCount) return rowIndices[rowOffset] - 0.5f;
+            if (rowOffset > 0) return rowIndices[rowOffset - 1] + 0.5f;
+            return rowIndices[0] - 0.5f;
+        }
+
+        void SampleCorner(
+            int cornerRow,
+            int cornerCol,
+            int rowCount,
+            int cols,
+            int[] rowIndices,
+            out float avgHeight,
+            out Color32 avgColor,
+            out int dominantTex)
+        {
+            float heightSum = 0f;
+            int heightCount = 0;
+
+            float rTotal = 0f;
+            float gTotal = 0f;
+            float bTotal = 0f;
+            float aTotal = 0f;
+            int colorCount = 0;
+
+            int[] sampleTextures = new int[4];
+            int textureCount = 0;
+
+            TerrainOverlay ov = default;
+            int ovCount = 0;
+
+            for (int dr = -1; dr <= 0; dr++)
+            {
+                int sampleRow = cornerRow + dr;
+                if (sampleRow < 0 || sampleRow >= rowCount) continue;
+                int tileX = ResolveCornerRowIndex(sampleRow, rowCount, rowIndices);
+
+                for (int dc = -1; dc <= 0; dc++)
+                {
+                    int sampleCol = cornerCol + dc;
+                    if (sampleCol < 0 || sampleCol >= cols) continue;
+
+                    int tileY = sampleCol;
+                    float h = _sampleHeight(tileX, tileY);
+                    Color32 c = _sampleColor(tileX, tileY);
+                    int tex = _sampleTexture(tileX, tileY);
+
+                    heightSum += h;
+                    heightCount++;
+
+                    rTotal += c.r;
+                    gTotal += c.g;
+                    bTotal += c.b;
+                    aTotal += c.a;
+                    colorCount++;
+
+                    if (tex >= 0 && textureCount < sampleTextures.Length)
+                    {
+                        sampleTextures[textureCount++] = tex;
+                    }
+
+                    if (_sampleOverlay != null)
+                    {
+                        ov.Accumulate(_sampleOverlay(tileX, tileY));
+                        ovCount++;
+                    }
+                }
+            }
+
+            avgHeight = heightCount > 0 ? heightSum / heightCount : 0f;
+
+            if (colorCount > 0)
+            {
+                float inv = 1f / colorCount;
+                avgColor = new Color32(
+                    (byte)(rTotal * inv),
+                    (byte)(gTotal * inv),
+                    (byte)(bTotal * inv),
+                    (byte)(aTotal * inv));
+            }
+            else
+            {
+                avgColor = new Color32(128, 128, 128, 255);
+            }
+
+            if (ovCount > 0)
+            {
+                ov.Normalize(ovCount);
+                avgColor = ApplyTerrainOverlay(avgColor, ov, avgHeight);
+            }
+
+            dominantTex = 0;
+            if (textureCount > 0)
+            {
+                int bestTex = 0;
+                int bestCount = -1;
+                for (int i = 0; i < textureCount; i++)
+                {
+                    int candidate = sampleTextures[i];
+                    int candidateCount = 0;
+                    for (int j = 0; j < textureCount; j++)
+                    {
+                        if (sampleTextures[j] == candidate) candidateCount++;
+                    }
+
+                    if (candidateCount > bestCount)
+                    {
+                        bestCount = candidateCount;
+                        bestTex = candidate;
+                    }
+                }
+                dominantTex = bestTex;
+            }
+        }
