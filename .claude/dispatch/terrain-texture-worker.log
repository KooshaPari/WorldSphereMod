+        void SampleCorner(
+            int cornerRow,
+            int cornerCol,
+            int rowCount,
+            int cols,
+            int[] rowIndices,
+            out float avgHeight,
+            out Color32 avgColor,
+            out int dominantTex)
+        {
+            float heightSum = 0f;
