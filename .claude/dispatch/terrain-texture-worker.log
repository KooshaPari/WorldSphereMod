+            out int dominantTex)
+        {
+            float heightSum = 0f;
+            int heightCount = 0;
+
+            float rTotal = 0f;
+            float gTotal = 0f;
+            float bTotal = 0f;
+            float aTotal = 0f;
+            int colorCount = 0;
+
+            int[] sampleTextures = new int[4];
+            int textureCount = 0;
+
+            TerrainOverlay ov = default;
+            int ovCount = 0;
+
+            for (int dr = -1; dr <= 0; dr++)
