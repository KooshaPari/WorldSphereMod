+                avgColor = new Color32(
+                    (byte)(rTotal * inv),
+                    (byte)(gTotal * inv),
+                    (byte)(bTotal * inv),
+                    (byte)(aTotal * inv));
+            }
+            else
+            {
+                avgColor = new Color32(128, 128, 128, 255);
+            }
+
+            if (ovCount > 0)
