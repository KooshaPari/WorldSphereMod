            {
                // Prime logical-corner cache: each logical corner stores its own
                // averaged height/color to preserve smooth biome edges, while each
                // visible quad still gets duplicated vertices for UV mapping.
                Parallel.For(0, cornerRows, cr =>
                {
                    for (int cc = 0; cc < cornerCols; cc++)
                    {
                        int vi = cr * cornerCols + cc;
                        SampleCorner(cr, cc, rowCount, cols, rowIndices, out float cornerHeight, out Color32 baseColor, out _);
                        float noise = Mathf.PerlinNoise(cc * 0.1f, cr * 0.1f);
