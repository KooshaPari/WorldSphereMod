+        static int DominantTexture(int a, int b, int c, int d)
+        {
+            int maxCount = 0;
+            int winner = 0;
+
+            void CountAndSet(int v)
+            {
+                int count = (a == v ? 1 : 0) + (b == v ? 1 : 0) + (c == v ? 1 : 0) + (d == v ? 1 : 0);
+                if (count > maxCount)
+                {
+                    maxCount = count;
+                    winner = v;
+                }
+            }
+
+            CountAndSet(a);
+            if (b != a) CountAndSet(b);
+            if (c != a && c != b) CountAndSet(c);
+            if (d != a && d != b && d != c) CountAndSet(d);
+
+            if (winner < 0) winner = 0;
+            return winner;
+        }
