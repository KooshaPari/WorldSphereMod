                        _colors[vi] = baseColor;
                    }
                });

                int ti = 0;
                int dv = 0;
                for (int r = 0; r < rowCount; r++)
                {
                    int tileX = rowIndices[r];
                    int tileY = r; // placeholder; updated per col below
                    int dominantTex = 0;

                    for (int c = 0; c < cols; c++)
                    {
                        tileY = c;
                        dominantTex = _sampleTexture(tileX, tileY);
                        if (dominantTex < 0) dominantTex = 0;

                        int v0 = r * cornerCols + c;
                        int v1 = v0 + 1;
                        int v2 = v0 + cornerCols;
                        int v3 = v2 + 1;

                        int b0 = dv++;
                        int b1 = dv++;
                        int b2 = dv++;
                        int b3 = dv++;

                        float worldX0 = ResolveCornerWorldX(r, rowIndices, rowCount);
                        float worldX1 = ResolveCornerWorldX(r + 1, rowIndices, rowCount);
                        float worldY0 = c - 0.5f;
                        float worldY1 = worldY0 + 1f;

                        float h0 = _cornerHeights[v0];
                        float h1 = _cornerHeights[v1];
                        float h2 = _cornerHeights[v2];
                        float h3 = _cornerHeights[v3];

                        _vertices[b0] = _projectPosition(worldX0, worldY0, h0);
                        _vertices[b1] = _projectPosition(worldX0, worldY1, h1);
                        _vertices[b2] = _projectPosition(worldX1, worldY0, h2);
                        _vertices[b3] = _projectPosition(worldX1, worldY1, h3);

                        _colors[b0] = _colors[v0];
                        _colors[b1] = _colors[v1];
                        _colors[b2] = _colors[v2];
                        _colors[b3] = _colors[v3];

                        _uvs[b0] = new Vector2(0f, 0f);
                        _uvs[b1] = new Vector2(1f, 0f);
                        _uvs[b2] = new Vector2(0f, 1f);
                        _uvs[b3] = new Vector2(1f, 1f);
                        float slice = dominantTex;
                        _uvsSlice[b0] = new Vector2(slice, 0f);
                        _uvsSlice[b1] = new Vector2(slice, 0f);
                        _uvsSlice[b2] = new Vector2(slice, 0f);
                        _uvsSlice[b3] = new Vector2(slice, 0f);

                        _triangles[ti++] = b0;
                        _triangles[ti++] = b2;
                        _triangles[ti++] = b1;
                        _triangles[ti++] = b1;
                        _triangles[ti++] = b2;
                        _triangles[ti++] = b3;
