+        {
+            int rows = _manager.Rows;
+            int cols = _manager.Cols;
+            int rowCount = maxRow - minRow;
+            if (rowCount <= 0 || cols <= 0) return;
+
+            // Resolve the actual tile-row indices (may wrap).
+            int[] rowIndices = new int[rowCount];
+            for (int i = 0; i < rowCount; i++)
+            {
+                int raw = cameraX + minRow + i;
+                if (wrapped)
+                {
+                    raw = ((raw % rows) + rows) % rows;
+                }
+                else
+                {
+                    raw = Mathf.Clamp(raw, 0, rows - 1);
+                }
+                rowIndices[i] = raw;
+            }
+
+            _materialSetUsesTerrainTexture = UsesTerrainTextureArray();
+
+            // Vertex topology:
+            // - Shared corner path (default actor/building-compatible): one vertex per
+            //   logical terrain corner.
+            // - Terrain-array path: duplicated 4 vertices per quad so each quad owns
+            //   its own 0..1 UV patch and a uniform texture-slice coordinate.
+            int cornerRows = rowCount + 1;
+            int cornerCols = cols + 1;
+            int triCount = rowCount * cols * 6;
+            int vertCount = _materialSetUsesTerrainTexture ? rowCount * cols * 4 : cornerRows * cornerCols;
+
+            EnsureArrays(vertCount, triCount);
+
+            var sw = ProfileRebuild ? System.Diagnostics.Stopwatch.StartNew() : null;
+            long bakeMs = sw?.ElapsedMilliseconds ?? 0;
+
+            // Shared-corner samples: one sample pass for both shared and duplicated
+            // paths so per-corner height/color remains smooth.
+            Parallel.For(0, cornerRows, cr =>
+            {
+                for (int cc = 0; cc < cornerCols; cc++)
+                {
+                    int vi = cr * cornerCols + cc;
+                    SampleCorner(cr, cc, rowCount, cols, rowIndices, out float avgHeight, out Color32 baseColor, out int dominantTex);
+
+                    // Micro-displacement keeps adjacent quads from becoming perfectly flat.
+                    _cornerHeights[vi] = avgHeight + (Mathf.PerlinNoise(cc * 0.1f, cr * 0.1f) - 0.5f) * 0.3f;
+                    _colors[vi] = baseColor;
+                    _uvsSlice[vi] = Vector2.zero;
+                    _cornerTexture[vi] = dominantTex;
+
+                    if (_materialSetUsesTerrainTexture)
+                    {
