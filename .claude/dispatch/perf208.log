  408:        /// <summary>
  409:        /// Resolve each bone's mesh-space rest joint position. Bones that skin at
  410:        /// least one voxel use that voxel cluster's centroid. Bones with no voxels
  411:        /// (sprite never assigned them) fall back to parentCentroid + the
  412:        /// hardcoded HumanoidRig unit-space offset so the hierarchy stays
  413:        /// connected — these never skin any vertex, so their exact position only
  414:        /// matters for keeping child joints in a sane place.
  415:        /// </summary>
  416:        static Vector3[] ComputeBoneBindWorld(Vector3[] sum, int[] cnt, int boneCount)
  417:        {
  418:            var bind = new Vector3[boneCount];
  419:            var resolved = new bool[boneCount];
  420:            // Bones are declared parent-before-child (parent index < own index),
  421:            // so a single forward pass resolves parents before their children.
  422:            for (int b = 0; b < boneCount; b++)
  423:            {
  424:                if (cnt[b] > 0)
  425:                {
  426:                    bind[b] = sum[b] / cnt[b];
  427:                    resolved[b] = true;
  428:                    continue;
  429:                }
  430:
  431:                int parent = HumanoidRig.Bones[b].ParentIndex;
  432:                Vector3 parentPos = (parent >= 0 && parent < boneCount) ? bind[parent] : Vector3.zero;
  433:                bind[b] = parentPos + HumanoidRig.Bones[b].BindPoseOffset;
  434:                resolved[b] = true;
  435:            }
  436:
  437:            return bind;
  438:        }
