  386:                // keeps a vertex sitting exactly on a joint fully weighted to it.
  387:                const float eps = 1e-4f;
  388:                float dOwn = (verts[i] - boneBindWorld[b]).magnitude + eps;
  389:                float dPar = (verts[i] - boneBindWorld[parent]).magnitude + eps;
