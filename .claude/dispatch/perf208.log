            public static float Wrap(float value, float min, float max)
            {
                float range = max - min;
                if (range <= 0f)
                {
                    return min;
                }

                while (value < min)
                {
                    value += range;
                }

                while (value >= max)
                {
                    value -= range;
                }

                return value;
            }
