  309:        /// <summary>
  310:        /// Blend the overlay tints over a base biome color. Ordering matters:
  311:        /// burnt darkens first (it sits under everything), then corruption creep
  312:        /// (emissive violet, the most visually dominant living overlay), then snow
  313:        /// (white coverage, boosted by elevation), then frozen ice (pale blue,
  314:        /// applied last so a frozen surface always reads cold even under snow).
  315:        /// Each layer is a simple lerp by its coverage fraction — cheap, no shader.
  316:        /// </summary>
  317:        static Color32 ApplyTerrainOverlay(Color32 baseColor, TerrainOverlay ov, float elevation)
  318:        {
  319:            // Work in float RGB 0..1.
  320:            float r = baseColor.r / 255f;
  321:            float g = baseColor.g / 255f;
  322:            float b = baseColor.b / 255f;
  323:
  324:            // BURNT — dark char. Crush toward near-black with a faint warm ember.
  325:            if (ov.Burnt > 0.001f)
  326:            {
  327:                float t = Mathf.Clamp01(ov.Burnt);
  328:                r = Mathf.Lerp(r, 0.10f, t);
  329:                g = Mathf.Lerp(g, 0.07f, t);
  330:                b = Mathf.Lerp(b, 0.06f, t);
  331:            }
  332:
  333:            // CORRUPTION / TUMOR — emissive purple/violet creep. Push strongly
  334:            // toward violet and brighten slightly so it reads as glowing biomass.
  335:            if (ov.Corruption > 0.001f)
  336:            {
  337:                float t = Mathf.Clamp01(ov.Corruption);
  338:                r = Mathf.Lerp(r, 0.55f, t);
  339:                g = Mathf.Lerp(g, 0.08f, t);
  340:                b = Mathf.Lerp(b, 0.70f, t);
  341:            }
  342:
  343:            // SNOW — white coverage. Stronger at high elevation: peaks accumulate
  344:            // more snow than valleys for the same tile coverage value. Elevation
  345:            // is the corner's averaged terrain height (post micro-displacement).
  346:            if (ov.Snow > 0.001f)
  347:            {
  348:                // Map elevation to a 0.6..1.0 multiplier so high ground gets full
  349:                // snow while lowland snow stays partial. Heights are unscaled
  350:                // (pre-HeightMult) tile heights, typically ~0..30; clamp gently.
  351:                float elevBoost = 0.6f + 0.4f * Mathf.Clamp01(elevation / 24f);
  352:                float t = Mathf.Clamp01(ov.Snow * elevBoost);
  353:                r = Mathf.Lerp(r, 0.95f, t);
  354:                g = Mathf.Lerp(g, 0.96f, t);
  355:                b = Mathf.Lerp(b, 1.00f, t);
  356:            }
  357:
  358:            // FROZEN — pale-blue ice. Applied last; tints whatever is below cold.
  359:            if (ov.Frozen > 0.001f)
  360:            {
  361:                float t = Mathf.Clamp01(ov.Frozen);
  362:                r = Mathf.Lerp(r, 0.72f, t);
  363:                g = Mathf.Lerp(g, 0.85f, t);
  364:                b = Mathf.Lerp(b, 0.98f, t);
  365:            }
  366:
  367:            return new Color32(
  368:                (byte)(Mathf.Clamp01(r) * 255f),
  369:                (byte)(Mathf.Clamp01(g) * 255f),
  370:                (byte)(Mathf.Clamp01(b) * 255f),
  371:                255);
