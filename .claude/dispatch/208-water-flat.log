 1691:         /// <summary>
 1692:         /// Per-tile water state sampler for diagnostic / regression tests (#208 water-flat).
 1693:         /// Reads the same callbacks ConfigureHeightField wired into HeightFieldRenderer so
 1694:         /// the numbers reflect what the water sub-mesh is actually built with. We sample
 1695:         /// is-water + sampled water-level + sampled seabed for a set of tile coords. If the
 1696:         /// sampled water-level is constant across water tiles, the surface is flat (correct);
 1697:         /// if it tracks the seabed, the surface is sunken (regression).
 1698:         /// </summary>
 1699:         object BuildWaterSamplesPayload()
 1700:         {
 1701:             int w = 0, h = 0;
 1702:             float seaLevel = 0f;
 1703:             bool meshWater = false;
 1704:             try
 1705:             {
 1706:                 w = MapBox.width;
 1707:                 h = MapBox.height;
 1708:                 seaLevel = WorldSphereMod.Tools.TrueHeight(17);
 1709:                 meshWater = Core.savedSettings != null && Core.savedSettings.MeshWater;
 1710:             }
 1711:             catch { }
 1712: 
 1713:             var samples = new List<object>();
 1714:             if (w <= 0 || h <= 0)
 1715:             {
 1716:                 return new { ok = false, error = "no world", seaLevel, meshWater };
 1717:             }
 1718: 
 1719:             int[,] pts = {
 1720:                 { w / 2,  h / 2  },  // 50, 50 in a 100x100
 1721:                 { 50,     50     },
 1722:                 { 150,    150    },
 1723:                 { w / 8,  h / 8  },
 1724:                 { w / 4,  h / 2  },
 1725:                 { 3*w/4,  3*h/4  }
 1726:             };
 1727: 
 1728:             for (int i = 0; i < pts.GetLength(0); i++)
 1729:             {
 1730:                 int tx = pts[i, 0];
 1731:                 int ty = pts[i, 1];
 1732:                 if (tx < 0 || tx >= w || ty < 0 || ty >= h) continue;
 1733:                 bool isWater = false;
 1734:                 float tileHeight = float.NaN;
 1735:                 try
 1736:                 {
 1737:                     WorldTile tile = World.world != null ? World.world.GetTileSimple(tx, ty) : null;
 1738:                     if (tile != null)
 1739:                     {
 1740:                         tileHeight = tile.TileHeight();
 1741:                         isWater = Core.Sphere.IsWaterTilePublic(tile.main_type, tile.top_type, tileHeight, seaLevel);
 1742:                     }
 1743:                 }
 1744:                 catch { }
 1745:                 samples.Add(new
 1746:                 {
 1747:                     tx, ty,
 1748:                     isWater,
 1749:                     tileHeight,
 1750:                     sampledWaterLevel = seaLevel,    // callback returns constant
 1751:                     sampledSeabed = tileHeight,
 1752:                     depth = seaLevel - tileHeight
 1753:                 });
 1754:             }
 1755: 
 1756:             // Heuristic: all water tiles' sampledWaterLevel must be identical => surface flat.
 1757:             float firstWl = float.NaN;
 1758:             bool flat = true;
 1759:             foreach (var s in samples)
 1760:             {
 1761:                 var t = s.GetType();
 1762:                 bool iw = (bool)t.GetProperty("isWater").GetValue(s);
 1763:                 float wl = (float)t.GetProperty("sampledWaterLevel").GetValue(s);
 1764:                 if (iw)
 1765:                 {
 1766:                     if (float.IsNaN(firstWl)) firstWl = wl;
 1767:                     else if (Mathf.Abs(wl - firstWl) > 1e-3f) { flat = false; break; }
 1768:                 }
 1769:             }
 1770: 
 1771:             return new
 1772:             {
 1773:                 ok = true,
 1774:                 mapW = w, mapH = h,
 1775:                 seaLevel,
 1776:                 meshWater,
 1777:                 surfaceFlat = flat,
 1778:                 samples
 1779:             };
 1780:         }

