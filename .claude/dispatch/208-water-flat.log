                            {
                                float lvl = layer.Level(tileX, tileY);
                                float seabed = layer.Seabed != null ? layer.Seabed(tileX, tileY) : lvl;
                                float depth = lvl - seabed;
                                if (depth < 0f) depth = 0f;
                                lvlSum += lvl;
                                depthSum += depth;
                                liquidCount++;
                                if (depth > maxDepth) maxDepth = depth;
                            }
                            else touchesLand = true;
                        }
                    }

                    if (liquidCount == 0)
