                        float avgFps = avgFrameTime > 0f ? 1f / avgFrameTime : 0f;
                        Debug.Log($"[WSM3D][Perf] frameDeltaMs={deltaTimePerf * 1000f:F2} avg60FrameDeltaMs={avgFrameTime * 1000f:F2} avg60Fps={avgFps:F1}");
                        _perfFrameCounter = 0;
