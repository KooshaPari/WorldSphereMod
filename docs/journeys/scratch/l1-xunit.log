                    }
                });
                tRigTick = Measure(WorldSphereMod.Rig.RigCache.Tick);
                tRigDrain = Measure(WorldSphereMod.Rig.RigCache.DrainPendingDestroy);
                if (Core.savedSettings.SkeletalAnimation)
                {
