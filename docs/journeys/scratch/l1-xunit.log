                default: // Cull
                    return distSqr < voxelEnter ? LodTier.Voxel : LodTier.Cull;
            }
        }

        public static void ResetHysteresis()
        {
            _hyst.Clear();
        }

        public static void Remove(int instanceId) { _hyst.Remove(instanceId); }
    }
}
