                    $"SunUpdate={tSunUpdate:F2}ms " +
                    $"DecalTick={tDecalTick:F2}ms " +
                    $"EnvironmentalTick={tEnvironmentalTick:F2}ms " +
                    $"PostFxApply={tPostFxApply:F2}ms " +
